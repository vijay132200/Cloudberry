{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://workspaceapi-server-production-4503.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "pnpm --filter @workspace/cloudberry build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install"
}
